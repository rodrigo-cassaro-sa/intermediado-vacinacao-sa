# ============================================================================
# .env.example — copie para .env e ajuste. NUNCA versionar o .env real.
#
# ATENÇÃO: nem toda variável do projeto pode ficar aqui.
#
#   Este arquivo é lido pelo PHP (carregar_env, em app/config/config.php).
#   O entrypoint do container é um shell script — ele NÃO lê este arquivo.
#
#   Por isso as variáveis usadas antes do PHP subir (ou pelo próprio shell)
#   só têm efeito se forem definidas como variável de ambiente do container:
#   EasyPanel → serviço imz-app → Environment. Elas estão na seção 2, no fim.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Variáveis do APP — funcionam neste arquivo
# ----------------------------------------------------------------------------

APP_ENV=desenvolvimento          # desenvolvimento | homologacao | producao
APP_DEBUG=true                   # false em produção
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Sao_Paulo
APP_VERSION=dev                  # versão/commit publicado (aparece no /health e nas métricas)

# Banco de dados
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NOME=imunizacao
DB_USUARIO=root
DB_SENHA=

# Segurança
# Chave usada para HMAC/criptografia de dados sensíveis (gerar aleatória e única).
APP_CHAVE=troque-por-uma-chave-aleatoria-longa

# Sessão (segundos)
SESSAO_INATIVIDADE=1800          # 30 min
SESSAO_ABSOLUTA=28800            # 8 h

# Rate limit (requisições por minuto)
RATE_LIMIT_RPM=120               # padrão por credencial de parceiro (API)
RATE_LIMIT_LOGIN=20              # tentativas de login por IP/min

# ----------------------------------------------------------------------------
# 2. Variáveis do CONTAINER — NÃO funcionam neste arquivo
#
# Definir no EasyPanel (serviço imz-app → Environment). Listadas aqui só como
# referência: colocá-las no .env não tem efeito nenhum.
#
# AUTO_MIGRAR=true          Aplica migrations no start do container.
#                           Lido pelo shell em docker/entrypoint.sh.
#                           CUIDADO: para travar migration automática em produção
#                           não basta pôr false aqui — tem de ser no painel.
#
# WORKERS_EMBUTIDOS=true    Roda os workers de fila dentro do container
#                           (importações grandes e webhooks). false = desliga e
#                           você assume os Cron Jobs do painel. Lido pelo shell.
#
# WORKER_INTERVALO=15       Segundos entre as passadas do worker. Lido pelo shell.
#
# WORKER_MEMORIA=512M       Limite de memória do worker (o memory_limit do
#                           php.ini, 256M, vale para as requisições web). Lido em
#                           scripts/processar_importacoes.php ANTES do .env ser
#                           carregado — por isso também precisa vir do ambiente.
#
# Detalhes e valores medidos: docs/13-deploy-easypanel-producao.md
# ----------------------------------------------------------------------------
